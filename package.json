{
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.prod.json",
    "build:schemas": "glib-compile-schemas schemas/",
    "postbuild": "npm run build:schemas && cp metadata.json dist/ && mkdir -p dist/schemas && cp schemas/*.gschema.xml schemas/gschemas.compiled dist/schemas/",
    "build:dist": "npm run build && cd dist && zip -qr ../find-my-mouse@herve-brun.github.io.zip .",
    "lint": "eslint src/",
    "check": "tsc --noEmit",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "typescript": "^5.7",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@girs/cairo-1.0": "^1.0.0-4.0.0-rc.15",
    "@girs/gjs": "^4.0.0-rc.15",
    "@girs/gnome-shell": "^46.0"
  }
}
